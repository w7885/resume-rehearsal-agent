# 本地配置样例，不填写真实密钥后提交。
# 当前 main.py 从进程环境变量读取配置，不会自动加载本文件或 .env。
# 缺少密钥或以下开关未启用时，仅保存本机内容，不调用模型。
DEEPSEEK_API_KEY=
AGENT_ENABLED=0
# 图片先保存，聊天 Host 在统一预算保护下转录；未启用时只保存和预览。
VISION_ENABLED=0
VISION_MODEL=deepseek-flash
# 核对历史费用、费率与全项目账本后才由使用者明确启用。
AGENT_BUDGET_CONFIRMED=0
# 全项目累计上限，单位分；最大 3000，不按会话／日期重置。
AGENT_PROJECT_LIMIT_CENTS=3000
# 可选本地中文语音转文字；安装 requirements-voice.txt 和模型后可用，不调用付费 API。
VOICE_INPUT_ENABLED=1
# 相对路径以 backend 目录为起点；不配置时使用以下默认位置。
VOICE_MODEL_PATH=.local/voice-models/vosk-model-small-cn-0.22
